---
/**
 * Giving, with recurring as a real choice rather than a checkbox at the end.
 *
 * The toggle rewrites the amounts, because "monthly" only means something if
 * you can see what the monthly figure actually is. Every tier says what the
 * money buys: a donor deciding between $25 and $100 is really deciding between
 * a picture book and a story time kit, and that is the decision to show them.
 *
 * The amounts are suggestions for the demo and are labelled as such in the
 * content file. The foundation's real giving levels replace them before launch.
 */
import giving from '../content/giving.json';
---

<section class="section give" id="give">
  <div class="wrap">
    <header class="head reveal">
      <span class="figno">Fig. 05</span>
      <h2>Give once, or give every month</h2>
      <p class="prose sub">{giving.intro}</p>
    </header>

    <div class="switch reveal" role="group" aria-label="How often would you like to give">
      <button type="button" class="sw is-on" data-freq="once" aria-pressed="true">One time</button>
      <button type="button" class="sw" data-freq="monthly" aria-pressed="false">Monthly</button>
      <span class="sw-note" data-freq-note>A single gift, whenever you choose.</span>
    </div>

    <form
      class="tiers"
      name="donation"
      method="POST"
      data-netlify="true"
      netlify-honeypot="company"
      action="/thank-you/?kind=donation"
      data-reveal-group
    >
      <input type="hidden" name="form-name" value="donation" />
      <input type="hidden" name="frequency" value="once" data-freq-field />
      <p class="hp" hidden><label>Do not fill this in <input name="company" /></label></p>

      <ul class="tier-list">
        {giving.tiers.map((t, i) => (
          <li class={`tier reveal${t.featured ? ' tier--featured' : ''}`}>
            <label>
              <input type="radio" name="amount" value={String(t.amount)} data-once={String(t.amount)} data-monthly={String(t.monthly)} checked={i === 1} />
              <span class="t-inner">
                <span class="t-top">
                  <span class="t-name">{t.name}</span>
                  {t.featured && <span class="t-flag">Most support</span>}
                </span>
                <span class="t-amount">
                  <span class="t-cur">$</span><span class="t-val" data-amount>{t.amount}</span><span class="t-per" data-per hidden>/mo</span>
                </span>
                <span class="t-buys">{t.buys}</span>
              </span>
            </label>
          </li>
        ))}
      </ul>

      <div class="custom">
        <div class="field">
          <label for="other">Another amount</label>
          <input id="other" name="other_amount" type="number" min="1" step="1" inputmode="numeric" placeholder="$" />
        </div>
        <div class="field">
          <label for="donor-name">Your name</label>
          <input id="donor-name" name="donor_name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="donor-email">Email</label>
          <input id="donor-email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>

      <div class="submit">
        <button class="btn btn--brass" type="submit"><span data-submit-label>Give $100 once</span></button>
        <p class="fine">
          This demo records your intent and emails the foundation. Connecting a live payment
          processor is a setup step, not a rebuild.
        </p>
      </div>
    </form>

    <aside class="legacy reveal">
      <span class="figno">The long game</span>
      <h3>{giving.legacy.title}</h3>
      <p>{giving.legacy.body}</p>
      <a class="btn btn--outline btn--outline-ink" href="#connect"><span>Ask about the programme</span></a>
    </aside>
  </div>
</section>

<script>
  const freqButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-freq]'));
  const freqField = document.querySelector<HTMLInputElement>('[data-freq-field]');
  const freqNote = document.querySelector<HTMLElement>('[data-freq-note]');
  const label = document.querySelector<HTMLElement>('[data-submit-label]');
  const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="amount"]'));
  const other = document.querySelector<HTMLInputElement>('#other');

  let frequency: 'once' | 'monthly' = 'once';

  const NOTES = {
    once: 'A single gift, whenever you choose.',
    monthly: 'A smaller amount every month. Cancel any time.',
  };

  /** Rewrite every displayed amount, and the button, for the chosen frequency. */
  const render = () => {
    for (const radio of radios) {
      const value = frequency === 'monthly' ? radio.dataset.monthly : radio.dataset.once;
      radio.value = value ?? '';
      const row = radio.closest('.tier');
      const val = row?.querySelector<HTMLElement>('[data-amount]');
      const per = row?.querySelector<HTMLElement>('[data-per]');
      if (val) val.textContent = value ?? '';
      if (per) per.hidden = frequency !== 'monthly';
    }
    if (freqNote) freqNote.textContent = NOTES[frequency];
    if (freqField) freqField.value = frequency;

    const chosen = radios.find((r) => r.checked);
    const amount = other?.value ? other.value : chosen?.value;
    if (label) {
      label.textContent = amount
        ? `Give $${amount} ${frequency === 'monthly' ? 'a month' : 'once'}`
        : 'Choose an amount';
    }
  };

  for (const b of freqButtons) {
    b.addEventListener('click', () => {
      frequency = (b.dataset.freq as 'once' | 'monthly') ?? 'once';
      for (const other of freqButtons) {
        const on = other === b;
        other.classList.toggle('is-on', on);
        other.setAttribute('aria-pressed', String(on));
      }
      render();
    });
  }

  radios.forEach((r) =>
    r.addEventListener('change', () => {
      // Picking a tier should clear a typed amount, or the button lies.
      if (other) other.value = '';
      render();
    }),
  );
  other?.addEventListener('input', () => {
    if (other.value) radios.forEach((r) => (r.checked = false));
    render();
  });

  render();
</script>

<style>
  .give {
    background: var(--ink);
    color: var(--on-ink);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-bottom: clamp(1.6rem, 4vw, 2.4rem);
  }
  .head h2 {
    font-size: clamp(1.9rem, 4.4vw, 3.2rem);
    color: var(--white);
  }
  .sub {
    color: var(--on-ink-soft);
  }

  .switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-bottom: 1.8rem;
  }
  .sw {
    border: 1px solid var(--rule-ink);
    background: transparent;
    color: var(--on-ink-soft);
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.7rem 1.4rem;
    border-radius: 2px;
    cursor: pointer;
    transition: background-color var(--fast) var(--ease), color var(--fast) var(--ease),
      border-color var(--fast) var(--ease);
  }
  .sw:hover {
    border-color: var(--brass);
    color: var(--on-ink);
  }
  .sw.is-on {
    background: var(--brass);
    border-color: var(--brass);
    color: var(--ink-deep);
  }
  .sw-note {
    font-size: 0.86rem;
    color: var(--on-ink-soft);
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .tier-list {
    list-style: none;
    margin: 0 0 1.8rem;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--rule-ink);
    border: 1px solid var(--rule-ink);
  }
  @media (min-width: 820px) {
    .tier-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tier label {
    display: block;
    height: 100%;
    background: var(--ink);
    cursor: pointer;
    transition: background-color var(--fast) var(--ease);
  }
  .tier input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .t-inner {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.3rem, 2.6vw, 1.9rem) clamp(1.1rem, 2vw, 1.5rem);
    height: 100%;
    border-top: 2px solid transparent;
  }
  .tier label:hover .t-inner {
    background: rgba(242, 238, 226, 0.04);
  }
  .tier input:checked + .t-inner {
    background: rgba(194, 216, 50, 0.08);
    border-top-color: var(--citrus);
  }
  .tier input:focus-visible + .t-inner {
    outline: 2px solid var(--citrus);
    outline-offset: -2px;
  }
  .t-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .t-name {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brass-light);
  }
  .t-flag {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-deep);
    background: var(--citrus);
    padding: 0.1rem 0.4rem;
    border-radius: 2px;
  }
  .t-amount {
    font-family: var(--display);
    font-size: clamp(2rem, 3.6vw, 2.7rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }
  .t-cur {
    font-size: 0.55em;
    vertical-align: 0.42em;
    margin-right: 0.04em;
  }
  .t-per {
    font-family: var(--sans);
    font-size: 0.3em;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: 0.6em;
    color: var(--on-ink-soft);
    margin-left: 0.25em;
  }
  .t-buys {
    font-size: 0.9rem;
    color: var(--on-ink-soft);
    line-height: 1.45;
  }

  .custom {
    display: grid;
    gap: 1.2rem 2rem;
    margin-bottom: 1.8rem;
  }
  @media (min-width: 700px) {
    .custom {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .custom .field label {
    color: var(--on-ink-soft);
  }
  .custom .field input {
    color: var(--on-ink);
    border-bottom-color: var(--rule-ink);
  }
  .custom .field input:focus {
    border-bottom-color: var(--citrus);
  }

  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.8rem;
  }
  .fine {
    font-size: 0.83rem;
    color: var(--on-ink-soft);
    max-width: 42ch;
  }

  .legacy {
    margin-top: clamp(2.6rem, 6vw, 4rem);
    padding-top: clamp(2rem, 4vw, 2.8rem);
    border-top: 1px solid var(--rule-ink);
    display: grid;
    gap: 0.7rem;
    max-width: 52ch;
  }
  .legacy h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--white);
  }
  .legacy p {
    color: var(--on-ink-soft);
  }
  .legacy .btn {
    justify-self: start;
    margin-top: 0.6rem;
    color: var(--brass-light);
  }
</style>
